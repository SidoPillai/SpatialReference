"n-952yVE":{"type":"image","data":{"image":"r-QwsTpo","caption":"A selection of 2D ArcGIS basemaps"}},"n-gSk3V8":{"type":"text","data":{"text":"Over the years, Esri has provided ArcGIS users with a growing collection of basemaps, plus a vector tile style editor enabling users to create custom bases. The basemaps were designed to suit a wide variety of uses. These include vector basemaps that provide general context, as well as photorealistic imagery bases. A sampling:","type":"paragraph","textAlignment":"start"}},"n-FwGFIV":{"type":"text","data":{"text":"Topographic...","type":"h3","textAlignment":"center"},"config":{"size":"wide"}},"n-TMGV0n":{"type":"immersive-narrative-panel","data":{"position":"center","size":"small","panelStyle":"themed"},"children":["n-FwGFIV"]},"n-Csy7yw":{"type":"webmap","data":{"caption":"Topographic","map":"r-67372ff42cd145319639a99152b15bc3","timeSlider":false,"viewPlacement":"extent","extent":{"spatialReference":{"latestWkid":3857,"wkid":102100},"xmin":-13635005.52998866,"ymin":4545910.748233736,"xmax":-13622660.949920619,"ymax":4552856.963179143},"center":{"spatialReference":{"latestWkid":3857,"wkid":102100},"x":-13628833.23995464,"y":4549383.855706439},"zoom":13.999999999999893,"viewpoint":{"rotation":0,"scale":36111.90964300383,"targetGeometry":{"spatialReference":{"latestWkid":3857,"wkid":102100},"x":-13628833.23995464,"y":4549383.855706439}}}},"n-lSHqhf":{"type":"immersive-slide","data":{"transition":"fade"},"children":["n-TMGV0n","n-Csy7yw"]},"n-85Pjrn":{"type":"text","data":{"text":"OpenStreetMap...","type":"h3","textAlignment":"center"},"config":{"size":"wide"}},"n-t7jJBj":{"type":"immersive-narrative-panel","data":{"position":"center","size":"small","panelStyle":"themed"},"children":["n-85Pjrn"]},"n-uzucqv":{"type":"webmap","data":{"caption":"OpenStreetMap","map":"r-fae788aa91e54244b161b59725dcbb2a","timeSlider":false,"viewPlacement":"extent","extent":{"spatialReference":{"latestWkid":3857,"wkid":102100},"xmin":-13635005.5299886