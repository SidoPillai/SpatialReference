xmax":-13622660.949920619,"ymax":4552856.963179143},"center":{"spatialReference":{"latestWkid":3857,"wkid":102100},"x":-13628833.23995464,"y":4549383.855706439},"zoom":13.999999999999893,"viewpoint":{"rotation":0,"scale":36111.90964300383,"targetGeometry":{"spatialReference":{"latestWkid":3857,"wkid":102100},"x":-13628833.23995464,"y":4549383.855706439}}}},"n-bZmsCv":{"type":"immersive-slide","data":{"transition":"fade"},"children":["n-RqZP2y","n-CAdAdU"]},"n-KZg7iv":{"type":"text","data":{"text":"...and Imagery Hybrid.","type":"h3","textAlignment":"center"},"config":{"size":"wide"}},"n-kHY2fW":{"type":"immersive-narrative-panel","data":{"position":"center","size":"small","panelStyle":"themed"},"children":["n-KZg7iv"]},"n-doPONy":{"type":"webmap","data":{"caption":"Imagery Hybrid","map":"r-86265e5a4bbb4187a59719cf134e0018","timeSlider":false,"viewPlacement":"extent","extent":{"spatialReference":{"latestWkid":3857,"wkid":102100},"xmin":-13635005.52998866,"ymin":4545910.748233736,"xmax":-13622660.949920619,"ymax":4552856.963179143},"center":{"spatialReference":{"latestWkid":3857,"wkid":102100},"x":-13628833.23995464,"y":4549383.855706439},"zoom":13.999999999999893,"viewpoint":{"rotation":0,"scale":36111.90964300383,"targetGeometry":{"spatialReference":{"latestWkid":3857,"wkid":102100},"x":-13628833.23995464,"y":4549383.855706439}}}},"n-pCdDEr":{"type":"immersive-slide","data":{"transition":"fade"},"children":["n-kHY2fW","n-doPONy"]},"n-8JKelu":{"type":"immersive","data":{"type":"sidecar","subtype":"floating-panel","narrativePanelPosition":"start","narrativePanelSize":"small"},"children":["n-lSHqhf","n-oZSSJJ","n-9sKAWL","n-bZmsCv","n-pCdDEr"]},"n-t596Vc":{"type":"text","data":{"text":"","type":"paragraph","textSize":"medium","textAlignment":"center"}},"n-TbfRci":{"type":"separator"},"n-uMUjy7":{"type":"text","data":{"type":"h2","text":"Introducing 3D basemaps","textAlignment":"center"}},"n-mQ1KOr":{"type":"text","data":{"type":"paragraph","text":"More recently, Esri began offering a free collection of 3D basemaps for ArcGIS users. These maps enhance the visualization and understanding of geographic information, enabling the creation of more immersive and interactive web scenes and apps."}},"n-oXTcNX":{"type":"image","data":{"caption":"Westminster Abbey in daylight, at night, and with trees","image":"r-kS2Zjg"}},"n-VQFkYR":{"type":"text","data":{"text":"Today, 3D visualization offers a realistic and intuitive view of the physical world, improving user comprehension, engagement, and decision-making. ArcGIS users can access these 3D basemaps via a gallery that is integrated within ArcGIS applications — including Scene Viewer — to share web scenes and apps within their organizations and beyond. ","type":"paragraph"}},"n-dJviPb":{"type":"text","data":{"text":"These 3D basemaps are available in several styles that provide general context, and which include features such as buildings, trees, and labels.  Esri has also provided a 3D basemap featuring imagery, but until now it has only included 2D imagery tiles that can be displayed in a 3D viewer.","type":"paragraph"}},"n-pIb7jt":{"type":"separator"},"n-SDPzaR":{"type":"text","data":{"type":"h2","text":"A natural evolution","textAlignment":"center"}},"n-HNtZtt":{"type":"text","data":{"type":"paragraph","text":"3D basemaps in ArcGIS have been a significant step toward creating a realistic viewer experience. Now, the Google photorealistic 3D basemap presents an opportunity to further enhance the user experience by incorporating photorealism."}},"n-kSW3Rj":{"type":"text","data":{"type":"paragraph","text":"Esri has collaborated with Google Maps Platform to integrate their Photorealistic 3D Tiles into ArcGIS. Beginning in Q4 2025, these tiles are now available (Preview) as the Google photorealistic 3D basemap in the ArcGIS 3D basemap gallery, right alongside our existing 2D basemaps, in <a href=\"https://doc.arcgis.com/en/arcgis-online/administer/configure-map.htm#ESRI_SECTION1_B98ECB95BE124A048DCD91CA03059F71\" rel=\"noopener noreferrer\" target=\"_blank\">supported applications</a> such as ArcGIS Pro and ArcGIS Online Scene Viewer."}},"n-iaI6zn":{"type":"text","data":{"text":"Once the basemap is added, users can create interactive web scenes enhancing their data visualization and storytelling capabilities. They can overlay additional GIS layers to enrich their projects with more detailed information. Users can also perform precise measurements and conduct viewshed analyses, which are crucial for urban planning, environmental studies, and more.","type":"paragraph"}},"n-ap3bGw":{"type":"text","data":{"text":"Additionally, the filtering tools will allow users to temporarily mask parts of the basemap, making it easy to insert alternative meshes or models for a more customized and dynamic presentation.","type":"paragraph"}},"n-ahlTPH":{"type":"text","data":{"text":"Let&apos;s &quot;fly&quot; to lower Manhattan for an example of this exciting new resource.","type":"paragraph"}},"n-R3wiBQ":{"type":"text","data":{"text":"New York City","type":"h3"},"config":{"size":"wide"}},"n-vjfvJL":{"type":"immersive-narrative-panel","data":{"position":"start","size":"small","panelStyle":"themed"},"children":["n-R3wiBQ"]},"n-GjRkuU":{"type":"webmap","data":{"map":"r-jS5IBr","caption":"3D bases","timeSlider":false,"viewPlacement":"extent","extent":{"spatialReference":{"latestWkid":3857,"wkid":102100},"xmin":-8486705.260412911,"ymin":4814290.999980675,"xmax":-7928952.411261284,"ymax":5128018.004427037},"center":{"spatialReference":{"latestWkid":3857,"wkid":102100},"x":-8207828.835837237,"y":4971154.502203958,"z":0},"zoom":8.802679234943822,"viewpoint":{"rotation":359.9519176795849,"scale":1323438.296071294,"targetGeometry":{"spatialReference":{"latestWkid":3857,"wkid":102100},"x":-8207828.84287695,"y":4971146.234784177,"z":24.02923414390534},"camera":{"position":{"spatialReference":{"latestWkid":3857,"wkid":102100},"x":-8207950.366638441,"y":4827384.196600804,"z":451734.902